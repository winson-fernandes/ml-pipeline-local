FROM python:3.10-slim

WORKDIR /app

COPY frontend-app/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Only the feature-engineering module is needed here (it has no heavy
# dependencies like torch) so api.py can import the same transform that
# data_preprocess.py uses, instead of keeping a second hand-copied version.
COPY src/__init__.py ./src/__init__.py
COPY src/common/__init__.py ./src/common/__init__.py
COPY src/common/features.py ./src/common/features.py
COPY frontend-app/backend/api.py .

EXPOSE 8000

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
